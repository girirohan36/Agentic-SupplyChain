# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.api  —  Supply Demand Agentic AI · FastAPI service
#
# Multi-stage build:
#   Stage 1 (builder) — install dependencies into a clean venv
#   Stage 2 (runtime) — copy only the venv + app code; no build tools in prod
#
# Usage:
#   docker build -f Dockerfile.api -t supply-demand-api .
#   docker run -p 8000:8000 --env-file .env supply-demand-api
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Create a clean virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install Python dependencies first (Docker cache layer)
COPY requirements.txt .
RUN pip install --upgrade pip --quiet && \
    pip install --no-cache-dir -r requirements.txt --quiet


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

# Security: run as non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Copy only the virtual environment from the builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY agents/       ./agents/
COPY api/          ./api/
COPY config/       ./config/
COPY data/         ./data/
COPY graph/        ./graph/
COPY models/       ./models/
COPY tools/        ./tools/

# Ensure the data directory exists for SQLite
RUN mkdir -p /app/data/sample_data && \
    chown -R appuser:appuser /app

USER appuser

# Expose FastAPI port
EXPOSE 8000

# Healthcheck — calls the /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Seed DB on first run, then start uvicorn
CMD ["sh", "-c", "python data/seed_data.py 2>/dev/null || true && uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2"]
